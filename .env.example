DATABASE_URL=postgres://postgres:postgres@localhost:5433/adjudica
AI_GATEWAY_API_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Judge / embedding model config — all optional, defaults shown below.
# JUDGE_FALLBACK_MODEL is only used by /api/derive-map (see plan notes on why
# /api/evaluate's streaming call doesn't do a live fallback).
# /api/evaluate makes two sequential model calls (decompose, then verify).
# JUDGE_DECOMPOSE_MODEL lets you point the simpler decompose step at a
# cheaper/faster model; if unset it reuses JUDGE_MODEL for both calls.
# JUDGE_MODEL=openai/gpt-5-mini
# JUDGE_DECOMPOSE_MODEL=
# JUDGE_FALLBACK_MODEL=
# JUDGE_TIMEOUT_MS=25000
# JUDGE_DECOMPOSE_TIMEOUT_MS=20000
# JUDGE_MAX_RETRIES=2
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Rate limits — all optional, defaults shown below.
# RATE_LIMIT_EVALUATE_PER_HOUR=20
# RATE_LIMIT_DERIVE_MAP_PER_HOUR=10
# RATE_LIMIT_SIGNUP_PER_HOUR=5
